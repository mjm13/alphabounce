{
  "mcpServers": {
    "mysql-app": {
      "command": "npx",
      "args": ["-y", "mcp-server-mysql@latest"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "root",
        "MYSQL_DB": "app_db",
        "MCP_DB_NAME": "app_db"
      }
    },
    "mysql-app-test": {
      "command": "npx",
      "args": ["-y", "mcp-server-mysql@latest"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "root",
        "MYSQL_DB": "app_db_test",
        "MCP_DB_NAME": "app_db_test"
      }
    },
    "codegraph-backend": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "${workspaceFolder}/{{backend_path}}"
      ]
    },
    "codegraph-frontend": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "${workspaceFolder}/{{frontend_path}}"
      ]
    }
  }
}
