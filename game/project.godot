; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

godot_mcp/enabled=true
godot_mcp/path="res://addons/godot_mcp/plugin.cfg"

[application]

config/name="AlphaBounce"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

MCPGameBridge="res://addons/godot_mcp/game_bridge/mcp_game_bridge.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/size/mode=2
window/stretch/mode="viewport"
input_devices/pointing/show_mouse=true

[rendering]

renderer/rendering_method="mobile"
anchors_and_margins/use_screen_constants=true
textures/vram_compression/import_etc2_astc=true

[input]
tap_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":65,"physical_keycode":0,"key_label":"","unicode":0,"location":0,"echo":false,"pressed":false,"pressure":0.0,"device":-1,"window_id":0,"script":null)]
}
