# Toolchain (downloaded locally, not committed)
tools/

# Godot Android build output
android/build/
android/.godot/
android/export.cfg

# Keystore + local secrets
android/debug.keystore
android/keystore.local.env

# CodeGraph index (local, regenerated)
**/.codegraph/

# Local telemetry log (regenerated by hooks)
observability/

# Python bytecode from hook scripts (regenerated)
__pycache__/
*.pyc

# OS / editor temp
*.tmp
.DS_Store
